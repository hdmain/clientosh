; ============================================================
;  clientosh – Inno Setup Script (generated from the .in template)
;  Version comes from CMakeLists.txt — do not edit version here.
;  Output: clientosh-@APP_VERSION@-win64-setup.exe
; ============================================================

#define AppName      "clientosh"
#define AppVersion   "@APP_VERSION@"
#define AppFileVersion "@APP_FILE_VERSION@"
#define AppPublisher "clientosh"
#define AppURL       "https://github.com/hdmain/clientosh"
#define AppExeName   "clientosh.exe"
#define BuildDir     "@BUILD_DIR@"

[Setup]
AppId={{B7A3C1D2-4E5F-4A6B-8C9D-0E1F2A3B4C5D}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
AllowNoIcons=yes
LicenseFile=@LICENSE_DIR@
OutputDir=@OUT_DIR@
OutputBaseFilename=clientosh-{#AppVersion}-win64-setup
SetupIconFile=@ICO_DIR@
UninstallDisplayIcon={app}\clientosh.ico
UninstallDisplayName={#AppName} {#AppVersion}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
RestartIfNeededByRun=no
CloseApplications=yes
DisableDirPage=auto
VersionInfoVersion={#AppFileVersion}
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} SSH Client
VersionInfoCopyright=MIT

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Main executable
Source: "{#BuildDir}\clientosh.exe";       DestDir: "{app}"; Flags: ignoreversion

; Application icon (used by shortcuts / uninstaller display)
Source: "@ICO_DIR@";                        DestDir: "{app}"; Flags: ignoreversion

; Bundle ALL runtime DLLs that sit beside the exe in the build dir: Qt, libssh,
; OpenSSL, the MinGW C++ runtime, and Qt's transitive deps (e.g.
; libdouble-conversion, ICU) that some Qt builds ship separately. Using a
; wildcard keeps the installer correct regardless of which Qt/toolchain the
; build used, without needing to enumerate every dependency.
Source: "{#BuildDir}\*.dll";                DestDir: "{app}"; Flags: ignoreversion

; Qt platform plugin
Source: "{#BuildDir}\platforms\*.dll";                      DestDir: "{app}\platforms";    Flags: ignoreversion

; Qt image format plugins
Source: "{#BuildDir}\imageformats\*.dll";                   DestDir: "{app}\imageformats"; Flags: ignoreversion

; Qt default style plugin (only present when windeployqt deployed it)
#if DirExists("{#BuildDir}\styles")
Source: "{#BuildDir}\styles\*.dll";                         DestDir: "{app}\styles";       Flags: ignoreversion
#endif

; Qt TLS / network / icon engine / generic plugins (added by windeployqt)
Source: "{#BuildDir}\tls\*.dll";                            DestDir: "{app}\tls";          Flags: ignoreversion
#if DirExists("{#BuildDir}\networkinformation")
Source: "{#BuildDir}\networkinformation\*.dll";             DestDir: "{app}\networkinformation"; Flags: ignoreversion
#endif
#if DirExists("{#BuildDir}\iconengines")
Source: "{#BuildDir}\iconengines\*.dll";                    DestDir: "{app}\iconengines";  Flags: ignoreversion
#endif
#if DirExists("{#BuildDir}\generic")
Source: "{#BuildDir}\generic\*.dll";                        DestDir: "{app}\generic";      Flags: ignoreversion
#endif

; Bundled first-party addons (AI agent, etc.) — installable offline from Settings
#if DirExists("{#BuildDir}\addons-bundle")
Source: "{#BuildDir}\addons-bundle\*"; DestDir: "{app}\addons-bundle"; Flags: ignoreversion recursesubdirs createallsubdirs
#endif

[Icons]
Name: "{group}\{#AppName}";          Filename: "{app}\{#AppExeName}"; IconFilename: "{app}\clientosh.ico"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}";     IconFilename: "{app}\clientosh.ico"
Name: "{autodesktop}\{#AppName}";    Filename: "{app}\{#AppExeName}"; IconFilename: "{app}\clientosh.ico"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(AppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
