{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-qt692-mingw",
      "displayName": "Windows - Qt 6.9.2 + MinGW 13.1 (local kit)",
      "description": "Pins the Windows build to the same Qt/compiler used for development and the release CI (C:/Qt/6.9.2/mingw_64 + Qt's mingw1310_64 toolchain, libssh/OpenSSL/FreeRDP from MSYS2 UCRT64).",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-win",
      "environment": {
        "PATH": "$penv{PATH};C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.9.2/mingw_64/bin"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.9.2/mingw_64",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "LIBSSH_ROOT": "C:/msys64/ucrt64",
        "FREERDP_ROOT": "C:/msys64/ucrt64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-qt692-mingw",
      "configurePreset": "windows-qt692-mingw",
      "environment": {
        "PATH": "$penv{PATH};C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.9.2/mingw_64/bin"
      }
    }
  ]
}
